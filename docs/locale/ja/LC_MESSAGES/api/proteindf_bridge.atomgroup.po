#: ../../docstring 9e7f37aca4114435bcf6bd44f0a79b3f of
#: proteindf_bridge.atomgroup.AtomGroup.merge:1
msgid "Merges another `AtomGroup` hierarchy into this group in-place."
msgstr "別の `AtomGroup` 階層をこのグループにインプレースでマージする。"

#: ../../docstring d224e02db1904f4d90295ead4f54052d of
#: proteindf_bridge.atomgroup.AtomGroup.merge:3
msgid ""
"Subgroups and atoms are merged recursively. Existing bonds and secondary "
"structure information from `other` are also incorporated."
msgstr "サブグループと原子は再帰的にマージされる。`other` からの既存の結合および二次構造情報も組み込まれる。"

#: ../../docstring fb57824286b44b6bae32732e8f70f402 of
#: proteindf_bridge.atomgroup.AtomGroup.merge:6
msgid "The atom group to merge into this group."
msgstr "このグループにマージする原子グループ。"

#: ../../docstring 7f0dc1ba18b84f0e822c32ab30fc59ff of
#: proteindf_bridge.atomgroup.AtomGroup.name:1
msgid "Name of this atom group."
msgstr "この原子グループの名前。"

#: ../../docstring f1f0846245ba4dbbb06478791f3de304 of
#: proteindf_bridge.atomgroup.AtomGroup.name:3
msgid "The group name."
msgstr "グループ名。"

#: ../../docstring bdc9abb5d5f146b0af648d87feb82d2a of
#: proteindf_bridge.atomgroup.AtomGroup.nuclei_charge:1
msgid "Nuclear charge of all atoms in this group and all descendant groups."
msgstr "このグループおよびすべての子孫グループ内のすべての原子の核電荷。"

#: ../../docstring e90dc4db13eb4de29e8e160c6727c4ef of
#: proteindf_bridge.atomgroup.AtomGroup.nuclei_charge:3
msgid ""
"For atoms where atomic number is zero, their partial charge is used "
"instead."
msgstr "原子番号がゼロの原子については、代わりにその部分電荷が使用される。"

#: ../../docstring 7907059d4f2c4fe8811409fb016d78e6 of
#: proteindf_bridge.atomgroup.AtomGroup.nuclei_charge:5
msgid "Total nuclear charge."
msgstr "全核電荷。"

#: ../../docstring 77bb31399e4b484c80c1075016d3ed37 of
#: proteindf_bridge.atomgroup.AtomGroup.parent:1
msgid "Parent `AtomGroup` in the hierarchy, or None if this is a root group."
msgstr "階層における親 `AtomGroup`、ルートグループの場合は None。"

#: ../../docstring e0a67ab7cf3d4c6895a0dce96b3f34c1 of
#: proteindf_bridge.atomgroup.AtomGroup.parent:3
msgid "The parent group reference, or None."
msgstr "親グループへの参照、または None。"

#: ../../docstring 9815f3265646467d9388593e05eeb67c of
#: proteindf_bridge.atomgroup.AtomGroup.path:1
msgid "Hierarchical path of this group from the root (e.g. \"/model_1/A/\")."
msgstr "ルートからのこのグループの階層パス (例: \"/model_1/A/\")。"

#: ../../docstring bc6a2c5264394d55b8acb8103ab9967b of
#: proteindf_bridge.atomgroup.AtomGroup.path:3
msgid "The hierarchical path."
msgstr "階層パス。"

#: ../../docstring 67e88eacb0b54c29a4d27f7840351834 of
#: proteindf_bridge.atomgroup.AtomGroup.path_depth:1
msgid "Returns the depth of this group in the hierarchy."
msgstr "階層におけるこのグループの深度を返す。"

#: ../../docstring 637f79d3212347e980228b29efa3a813 of
#: proteindf_bridge.atomgroup.AtomGroup.path_depth:3
msgid "The path depth (0 for root, 1 for model, 2 for chain, 3 for residue)."
msgstr "パス深度 (ルートなら0、モデルなら1、チェインなら2、残基なら3)。"

#: ../../docstring 1f9f3c6c79764d24b23562639967fba5 of
#: proteindf_bridge.atomgroup.AtomGroup.pickup_atoms:1
msgid ""
"Recursively searches and collects atoms whose key or name matches the "
"target string."
msgstr "キーまたは名前が対象文字列と一致する原子を再帰的に検索して収集する。"

#: ../../docstring 98945e94077d40aa802d0d8e91922d5d of
#: proteindf_bridge.atomgroup.AtomGroup.pickup_atoms:3
msgid "The atom key or name to match."
msgstr "一致対象の原子キーまたは名前。"

#: ../../docstring 0ccddf0f879941bfb70ef76e86fb4e9e of
#: proteindf_bridge.atomgroup.AtomGroup.pickup_atoms:6
msgid "List of matching atoms found across the hierarchy."
msgstr "階層全体で見つかった一致する原子のリスト。"

#: ../../docstring 450e5218feca494781e92ef012be421b of
#: proteindf_bridge.atomgroup.AtomGroup.real_nuclei_charge:1
msgid ""
"Sum of atomic numbers of all atoms in this group and all descendant "
"groups."
msgstr "このグループおよびすべての子孫グループ内のすべての原子の原子番号の総和。"

#: ../../docstring 1842edd1719f48a9942ceae1f1227841
#: 29b6b5d283e14db286a25d90254bca95 of
#: proteindf_bridge.atomgroup.AtomGroup.real_nuclei_charge:3
#: proteindf_bridge.atomgroup.AtomGroup.sum_of_atomic_number:3
msgid "Sum of atomic numbers."
msgstr "原子番号の総和。"

#: ../../docstring 9370da75116d41499a192631e93666be of
#: proteindf_bridge.atomgroup.AtomGroup.restructure:1
msgid ""
"Reorganizes atoms to match the hierarchy of a reference `AtomGroup` based"
" on coordinate proximity."
msgstr "座標の近接性に基づいて参照 `AtomGroup` の階層に一致するように原子を再構成する。"

#: ../../docstring fea8e3c3c47d448e988cc00bcd878790 of
#: proteindf_bridge.atomgroup.AtomGroup.restructure:3
msgid "Reference structure providing the target hierarchy."
msgstr "対象の階層を提供する参照構造。"

#: ../../docstring 4c329fe1e75242d89fbb36f27108c26c of
#: proteindf_bridge.atomgroup.AtomGroup.restructure:5
msgid "Proximity distance threshold in Angstroms. Defaults to 1.0e-5."
msgstr "オングストローム単位の近接距離閾値。デフォルトは 1.0e-5。"

#: ../../docstring 41194f11d17b4533b21afaff3bd66a23 of
#: proteindf_bridge.atomgroup.AtomGroup.restructure:8
msgid "A new restructured atom group."
msgstr "再構成された新しい原子グループ。"

#: ../../docstring 7eeb789badc84ce1b0ad930e12dc8e6c of
#: proteindf_bridge.atomgroup.AtomGroup.rotate:1
msgid ""
"Rotates all atomic coordinates in this hierarchy using a 3x3 rotation "
"matrix."
msgstr "3x3 回転行列を用いてこの階層内のすべての原子座標を回転させる。"

#: ../../docstring 59f33b63297f4785b6fae0c034950ee3 of
#: proteindf_bridge.atomgroup.AtomGroup.rotate:3
msgid ""
"A 3x3 rotation matrix. Accepts a :class:`Matrix` instance or any object "
"providing `rows`, `cols`, and `get(row, col)`."
msgstr ""
"3x3 回転行列。:class:`Matrix` インスタンス、または `rows`, `cols`, `get(row, col)` "
"を提供する任意のオブジェクトを受け付ける。"

#: ../../docstring 6da4e3693e3445c2acf1c1ecc41004e6 of
#: proteindf_bridge.atomgroup.AtomGroup.rotate:7
msgid "If `rotmat` is not a :class:`Matrix` or lacks `rows`, `cols`, or `get`."
msgstr "`rotmat` が :class:`Matrix` でないか、`rows`, `cols`, `get` を欠いている場合。"

#: ../../docstring 8f1cdc6516f948cfb607dc9e537e7aef of
#: proteindf_bridge.atomgroup.AtomGroup.rotate:8
msgid "If the dimensions of `rotmat` are not 3x3."
msgstr "`rotmat` の次元が 3x3 でない場合。"

#: ../../docstring 4f9f74bc40be41cb845868e66225503f of
#: proteindf_bridge.atomgroup.AtomGroup.save_csv:1
msgid "Exports the hierarchical atom and group data to a CSV file."
msgstr "階層的な原子およびグループデータをCSVファイルに出力する。"

#: ../../docstring cd681c3ee668450f9516ad5de1079db6 of
#: proteindf_bridge.atomgroup.AtomGroup.save_csv:3
msgid "The CSV is written atomically via a temporary file."
msgstr "CSVは一時ファイルを介してアトミックに書き込まれる。"

#: ../../docstring 28b9430ee2a748d8bd145f025722a70c of
#: proteindf_bridge.atomgroup.AtomGroup.save_csv:5
msgid "Destination file path for the CSV file."
msgstr "CSVファイルの出力先ファイルパス。"

#: ../../docstring fe784af39d0a4379a932d8ba90132d0a of
#: proteindf_bridge.atomgroup.AtomGroup.save_csv:8
msgid "If file creation, writing, or renaming fails."
msgstr "ファイルの作成、書き込み、またはリネームに失敗した場合。"

#: ../../docstring 4ff9ae57e59d4df88cd4a87284a73e57 of
#: proteindf_bridge.atomgroup.AtomGroup.secondary_structure:1
msgid "Secondary structure code of this residue group ('H', 'E', '-', or None)."
msgstr "この残基グループの二次構造コード ('H', 'E', '-', または None)。"

#: ../../docstring 0848d170da584327a4261e1868ac709d of
#: proteindf_bridge.atomgroup.AtomGroup.secondary_structure:3
msgid "'H' for helix, 'E' for strand, '-' for loop, or None."
msgstr "ヘリックスは 'H'、ストランドは 'E'、ループは '-'、または None。"

#: ../../docstring b78933daa53444aca2c51bf70b53c58f of
#: proteindf_bridge.atomgroup.AtomGroup.select:1
msgid ""
"Extracts a subset of atoms/groups matching a selector into a new "
"`AtomGroup`."
msgstr "セレクタに一致する原子/グループのサブセットを新しい `AtomGroup` に抽出する。"

#: ../../docstring 81b672287dd34981b14cc9111b5d2445 of
#: proteindf_bridge.atomgroup.AtomGroup.select:3
msgid ""
"A selector object (e.g. `SelectSymbol`, `SelectName`, `SelectPath`, etc.)"
" or any object providing an `is_match` method."
msgstr ""
"セレクタオブジェクト (例: `SelectSymbol`, `SelectName`, `SelectPath` など)、または "
"`is_match` メソッドを提供する任意のオブジェクト。"

#: ../../docstring e7826c0eb7064a85b7c9d0cb5acea3e5 of
#: proteindf_bridge.atomgroup.AtomGroup.select:7
msgid "A new atom group containing only the matched components."
msgstr "一致したコンポーネントのみを含む新しい原子グループ。"

#: ../../docstring d7bf60f6b8404a6fa0992dff2ed3f6f2 of
#: proteindf_bridge.atomgroup.AtomGroup.select:10
msgid "If `selector` is not a recognized selector type."
msgstr "`selector` が認識可能なセレクタ型でない場合。"

#: ../../docstring 1cade0e8734f4d3391866f310c9bccf4 of
#: proteindf_bridge.atomgroup.AtomGroup.set_atom:1
msgid "Inserts an atom into this group or at a specified hierarchical path."
msgstr "このグループ内、または指定された階層パスに原子を挿入する。"

#: ../../docstring 7775a0b5b6514576bc2e97d4fd70d687 of
#: proteindf_bridge.atomgroup.AtomGroup.set_atom:3
msgid ""
"If `key` contains path separators (e.g. ``\"subgroup/C1\"``), "
"intermediate child groups are created as needed and the atom is inserted "
"at the leaf. The inserted atom is deep-copied into the tree."
msgstr ""
"`key` にパス区切り文字が含まれる場合 (例: "
"``\"subgroup/C1\"``)、必要に応じて中間子グループが作成され、原子は末端に挿入される。挿入された原子は木内にディープコピーされる。"

#: ../../docstring 70e6df467e104e69946cd5da3b7fd012 of
#: proteindf_bridge.atomgroup.AtomGroup.set_atom:7
msgid "The atom key or relative/absolute path."
msgstr "原子のキー、または相対/絶対パス。"

#: ../../docstring c60277cf077e4c69a856017de73d57ad of
#: proteindf_bridge.atomgroup.AtomGroup.set_atom:9
msgid "The atom to insert."
msgstr "挿入する原子。"

#: ../../docstring 58acbaf4fa8e406ab88601773d5ce759 of
#: proteindf_bridge.atomgroup.AtomGroup.set_atom:12
msgid "If `atom` is not an `Atom` instance."
msgstr "`atom` が `Atom` インスタンスでない場合。"

#: ../../docstring 52610d64e9404eff89ccdbf1cb541703 of
#: proteindf_bridge.atomgroup.AtomGroup.set_by_dict_data:1
msgid "Replaces the group content with data loaded from a nested dictionary."
msgstr "グループの内容をネストした辞書から読み込まれたデータで置き換える。"

#: ../../docstring 80aa9872bf2340249d69b5144b52c731 of
#: proteindf_bridge.atomgroup.AtomGroup.set_by_dict_data:3
msgid "Unrecognized keys at top level are ignored."
msgstr "トップレベルの認識されないキーは無視される。"

#: ../../docstring a5b853df657c4e13a2fe35bfe5becd67 of
#: proteindf_bridge.atomgroup.AtomGroup.set_by_dict_data:5
msgid "Nested dictionary representing tree data."
msgstr "木データを表すネストした辞書。"

#: ../../docstring 54834458f5c64092831c65da132380a7 of
#: proteindf_bridge.atomgroup.AtomGroup.set_by_dict_data:8
msgid "Self, populated with the dictionary data."
msgstr "辞書データが設定された自身 (self)。"

#: ../../docstring 60372106b36445498e3ede7bc90cb94c of
#: proteindf_bridge.atomgroup.AtomGroup.set_by_dict_data:11
msgid "If `data` is not a dict."
msgstr "`data` が dict でない場合。"

#: ../../docstring 069f675eda9841c0a0f7a28c4bac0f66 of
#: proteindf_bridge.atomgroup.AtomGroup.set_by_dict_data:12
msgid "If nested atom data within the dictionary is invalid."
msgstr "辞書内のネストした原子データが無効な場合。"

#: ../../docstring a9a51f21821042cd8cfdef5bb08cfa95 of
#: proteindf_bridge.atomgroup.AtomGroup.set_group:1
msgid "Inserts a child group into this group with the specified key."
msgstr "指定されたキーでこのグループに子グループを挿入する。"

#: ../../docstring 132dc92c058e4f9787ce80897464031b of
#: proteindf_bridge.atomgroup.AtomGroup.set_group:3
msgid "The inserted group is deep-copied into the tree."
msgstr "挿入されたグループは木内にディープコピーされる。"

#: ../../docstring 2cb225aab7cd4f6db3fdcd6af2bb899d of
#: proteindf_bridge.atomgroup.AtomGroup.set_group:7
msgid "The child group to insert."
msgstr "挿入する子グループ。"

#: ../../docstring 43ca6b69c78c46b697151b1cb99df3a4 of
#: proteindf_bridge.atomgroup.AtomGroup.set_group:10
msgid "If `group` is not an `AtomGroup` instance."
msgstr "`group` が `AtomGroup` インスタンスでない場合。"

#: ../../docstring 5769801c4b9d459d938ee903fd899fcc of
#: proteindf_bridge.atomgroup.AtomGroup.setup:1
msgid ""
"Assigns standard bonds, bond orders, and atom types using the built-in "
"CCD template database."
msgstr "組み込みCCDテンプレートデータベースを使用して、標準的な結合、結合次数、原子タイプを割り当てる。"

#: ../../docstring 6891906e80da424590765df29fcc229f
#: 7bdca374f390439d910cdfdc0c948c74 of
#: proteindf_bridge.atomgroup.AtomGroup.setup:3
#: proteindf_bridge.atomgroup.AtomGroup.setup_with_db:6
msgid "If an atom has an unrecognized symbol or lacks covalent radius data."
msgstr "原子の元素記号が認識されないか、共有結合半径データを欠いている場合。"

#: ../../docstring 255e09e2d8a04fb99ae29561f7b2c45a of
#: proteindf_bridge.atomgroup.AtomGroup.setup_with_db:1
msgid ""
"Assigns bonds, bond orders, and atom types using a provided CCD template "
"database."
msgstr "提供されたCCDテンプレートデータベースを使用して、結合、結合次数、原子タイプを割り当てる。"

#: ../../docstring 68e9ba1a905b44afa22dae25717c9c5b of
#: proteindf_bridge.atomgroup.AtomGroup.setup_with_db:3
msgid "The Chemical Component Dictionary template database."
msgstr "Chemical Component Dictionary (CCD) テンプレートデータベース。"

#: ../../docstring fbcc0ff5279b415a858bcd8e70b6e081 of
#: proteindf_bridge.atomgroup.AtomGroup.shift_by:1
msgid ""
"Translates all atomic coordinates in this hierarchy by a displacement "
"vector."
msgstr "変位ベクトルによりこの階層内のすべての原子座標を並進させる。"

#: ../../docstring 37a0b525c66d4efcbd99dca2e370df5b of
#: proteindf_bridge.atomgroup.AtomGroup.shift_by:3
msgid "The translation displacement vector."
msgstr "並進変位ベクトル。"

#: ../../docstring e0f6baac861d410d86e1ba494e39c4f9 of
#: proteindf_bridge.atomgroup.AtomGroup.shift_by:6
msgid "If `dir` cannot be converted to a `Position`."
msgstr "`dir` を `Position` に変換できない場合。"

#: ../../docstring 6168b44616d74685ab8d3b4f4f6d45a7 of
#: proteindf_bridge.atomgroup.AtomGroup.sort_atoms:1
msgid "Sorting mode for direct atoms."
msgstr "直接の原子のソートモード。"

#: ../../docstring 817986039bbd4c98a1d5338dc85268fe of
#: proteindf_bridge.atomgroup.AtomGroup.sort_atoms:3
msgid ""
"Setting to ``\"nice\"`` enables natural (alphanumeric) sorting of atom "
"keys (e.g. \"C1\", \"C2\", \"C10\" instead of alphabetical \"C1\", "
"\"C10\", \"C2\") when accessing atoms. Setting to None maintains "
"insertion order."
msgstr ""
"``\"nice\"`` に設定すると、原子へのアクセス時に原子キーの自然順 (英数字) ソート (例: アルファベット順の \"C1\", "
"\"C10\", \"C2\" ではなく \"C1\", \"C2\", \"C10\") が有効になる。None "
"に設定すると挿入順が維持される。"

#: ../../docstring 397ac0429dad46ec877dfcabfb4f2a9c
#: 7e35aae2faa64e34967f6a0425ceccb1 of
#: proteindf_bridge.atomgroup.AtomGroup.sort_atoms:7
#: proteindf_bridge.atomgroup.AtomGroup.sort_groups:7
msgid "The sorting mode (``\"nice\"`` or None)."
msgstr "ソートモード (``\"nice\"`` または None)。"

#: ../../docstring 3927ff2eccdf4e71b2b9730108789df9 of
#: proteindf_bridge.atomgroup.AtomGroup.sort_groups:1
msgid "Sorting mode for direct child groups."
msgstr "直接の子グループのソートモード。"

#: ../../docstring 8898b3eb393640b7b9814816e0dcd57c of
#: proteindf_bridge.atomgroup.AtomGroup.sort_groups:3
msgid ""
"Setting to ``\"nice\"`` enables natural (alphanumeric) sorting of group "
"keys (e.g. \"res1\", \"res2\", \"res10\" instead of alphabetical "
"\"res1\", \"res10\", \"res2\") when accessing child groups. Setting to "
"None maintains insertion order."
msgstr ""
"``\"nice\"`` に設定すると、子グループへのアクセス時にグループキーの自然順 (英数字) ソート (例: アルファベット順の "
"\"res1\", \"res10\", \"res2\" ではなく \"res1\", \"res2\", \"res10\") "
"が有効になる。None に設定すると挿入順が維持される。"

#: ../../docstring 5809fb3194494593b8d652ed09482cd9 of
#: proteindf_bridge.atomgroup.AtomGroup.sum_of_atomic_number:1
msgid ""
"Returns the sum of atomic numbers of all atoms in this group and "
"descendant groups."
msgstr "このグループおよび子孫グループ内のすべての原子の原子番号の総和を返す。"

#: ../../docstring c908b6bc77694c5bb44470257ad4fac3 of
#: proteindf_bridge.atomgroup.AtomGroup.validate_schema:1
msgid "Validates this group against the standard hierarchy schema."
msgstr "標準階層スキーマに対してこのグループを検証する。"

#: ../../docstring f09ee06e442d42d4b50d30a92569e32f of
#: proteindf_bridge.atomgroup.AtomGroup.validate_schema:3
msgid "A list of detected schema violations."
msgstr "検出されたスキーマ違反のリスト。"

#: ../../docstring 5018e1a21c88466a9b608aeced15c7b9 of
#: proteindf_bridge.atomgroup.AtomGroup.weight:1
msgid "Total molecular weight of all atoms in this group and descendant groups."
msgstr "このグループおよび子孫グループ内のすべての原子の総分子量。"

#: ../../docstring cf51e71be5a94d53a1ed69f84d47bde6 of
#: proteindf_bridge.atomgroup.AtomGroup.weight:3
msgid "Total molecular weight in atomic mass units (Da)."
msgstr "統一原子質量単位 (Da) での総分子量。"

