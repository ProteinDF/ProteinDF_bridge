#: proteindf_bridge.atomgroup.AtomGroup.erase_atom:1
#: proteindf_bridge.atomgroup.AtomGroup.remove_atom:1
msgid "Removes an atom with the given key from this group."
msgstr "指定されたキーを持つ原子をこのグループから削除する。"

#: ../../docstring 59edfc6b979f43ee875710716dfffe44
#: 5e1c2b53e6614e03820a367387e5b19c eb7a57d3f032440fb51b61f32955864e of
