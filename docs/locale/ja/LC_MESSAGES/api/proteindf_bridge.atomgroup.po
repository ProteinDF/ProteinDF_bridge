#: ../../docstring 6d5920379f194c0296b30486f270bde5 of
#: proteindf_bridge.atomgroup.AtomGroup.add_bond:9
msgid "The bond order (1 for single, 2 for double, etc.). Defaults to 1."
msgstr "結合次数 (単結合なら1、二重結合なら2など)。デフォルトは1。"

#: ../../docstring dca13a1ac681443ba034ede934097fdc of
#: proteindf_bridge.atomgroup.AtomGroup.add_missing_hydrogens:1
msgid "Adds missing hydrogen atoms based on CCD residue templates."
msgstr "CCD残基テンプレートに基づいて欠損水素原子を追加する。"

#: ../../docstring 7974dd7af35c4471b5ae77d87998733b of
#: proteindf_bridge.atomgroup.AtomGroup.add_missing_hydrogens:3
msgid ""
"The CCD template database to use. If None, the global default database is"
" used. Defaults to None."
msgstr "使用するCCDテンプレートデータベース。None の場合、グローバルデフォルトのデータベースが使用される。デフォルトは None。"

