#: ../../api/proteindf_bridge.dbmanager.rst:2 5ff598884f5d45dfa0731b89044c7039
msgid "proteindf\\_bridge.dbmanager module"
msgstr "proteindf\\_bridge.dbmanager モジュール"

#: 2c19d04c08e047c187a4a60906429168 of
#: proteindf_bridge.dbmanager.DbManager.create_table:1
msgid "Create a TABLE."
msgstr "TABLEを作成する"

#: e3223fbb20bf459888ca7140ddbeede3 of
#: proteindf_bridge.dbmanager.DbManager.create_table:3
#, python-brace-format
msgid ""
"table_name: the table name field_names: the field (column) names. If no type"
" is specified, field_names should be a list. If a type is specified, "
"field_names should be a dict of {name: type}."
msgstr ""
"table_name: テーブル名 field_names: フィールド(カラム)名 型を指定しない場合は、field_namesをリストにする。 "
"型を指定する場合は、field_namesは{名前:型}の辞書型にする。"

#: c3022d238e754b8fb60cc023aa1eb825 of
#: proteindf_bridge.dbmanager.DbManager.delete:1
msgid "Delete a data record."
msgstr "データレコードを削除"

#: 5c3cad31000f46488dbc21c959d8adae of
#: proteindf_bridge.dbmanager.DbManager.execute:1
msgid "Execute the SQL."
msgstr "SQLを実行する"

#: 701d36d0e28b4393896b5038a151f84c of
#: proteindf_bridge.dbmanager.DbManager.get_field_names:1
msgid "Return the fields within the specified TABLE as a list."
msgstr "指定されたTABLE内のフィールドをリストで返す"

#: 213a049f86e44afb8e9f9c77295d5809 of
#: proteindf_bridge.dbmanager.DbManager.get_primary_keys:1
msgid "Return the list of field names under the primary key constraint."
msgstr "primary key制約のフィールド名のリストを返す"

#: 4d426acb4f214696be6dc8e02fdea22a of
#: proteindf_bridge.dbmanager.DbManager.get_results:1
msgid "Execute the SQL and return the results as a list."
msgstr "SQLを実行し、結果をリストで返す"

#: 37f9d03dcc034c228de3180a69cc8238 of
#: proteindf_bridge.dbmanager.DbManager.get_table_names:1
msgid "Return the TABLE names as a list."
msgstr "TABLEの名前をリストで返す"

#: 839b8d64da854b668a11b0e8346ca4cc of
#: proteindf_bridge.dbmanager.DbManager.get_user_version:1
msgid "Return the user version."
msgstr "ユーザーバージョンを返す"

#: 93697d8c04fc4552a6be27481244fe94 of
#: proteindf_bridge.dbmanager.DbManager.has_table:1
msgid "Return whether the specified TABLE exists."
msgstr "指定されたTABLEを保持しているかどうかを返す"

#: 4f5ef3992d71423b81e4adc972fcd0dc of
#: proteindf_bridge.dbmanager.DbManager.insert:1
msgid "Insert a data record."
msgstr "データレコードを追加"

#: 3a7247420c72478287fd48894fb3a0f4 of
#: proteindf_bridge.dbmanager.DbManager.insert:3
msgid "contents is a dict keyed by field."
msgstr "contentsは、filedをキーとした辞書型"

#: dd670b3e578e4f9ea16b9e4290d921e3 of
#: proteindf_bridge.dbmanager.DbManager.pp:1
msgid "pretty print for cursor data"
msgstr "カーソルデータの整形表示"

#: 70da9f38d4f94e559023c18ca3753df0 of
#: proteindf_bridge.dbmanager.DbManager.pp_table:1
msgid "pretty print for table"
msgstr "テーブルの整形表示"

#: 3630710f1273493abb12b6be26a75464 of
#: proteindf_bridge.dbmanager.DbManager.select:1
msgid "Retrieve data. Only AND is supported in the where clause."
msgstr "データを取得する where句はANDのみサポート"

#: fca5caae6a134104a85a79842a4a1e4c of
#: proteindf_bridge.dbmanager.DbManager.set_user_version:1
msgid "Set the user version."
msgstr "ユーザーバージョンを設定する"

#: 467d7032d5774003afb9e9f9733cab3c of
#: proteindf_bridge.dbmanager.DbManager.update:1
msgid "Update a data record."
msgstr "データレコードを更新"

#: c3a7511709c043b5ab55499b22adfb71 of
#: proteindf_bridge.dbmanager.DbManager.update:3
msgid "contents and where are dicts keyed by field."
msgstr "contents、whereは、filedをキーとした辞書型"
