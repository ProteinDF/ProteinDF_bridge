msgstr "strをbytes(utf-8)に変換する。"

#: 8562297c47404535949850383f82ccf0 of
#: proteindf_bridge.str_processing.StrUtils.to_unicode:1
msgid "Convert bytes to str (utf-8)."
msgstr "byteをstr(utf-8)に変換する"

#: 42b408a8acdd4861a8040936f5aaf926 of
#: proteindf_bridge.str_processing.StrUtils.to_unicode_dict:1
msgid ""
"Convert a dict whose keys may include bytes into a dict where bytes keys "
