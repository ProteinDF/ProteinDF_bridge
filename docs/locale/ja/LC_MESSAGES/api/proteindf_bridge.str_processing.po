#: 6a1a61b8d96145e2a623595ba4c397e2 of
#: proteindf_bridge.str_processing.StrUtils.sort_nicely:1
msgid ""
"Sort the given list in the way that humans expect. ref: "
"http://www.codinghorror.com/blog/2007/12/sorting-for-humans-natural-sort-"
"order.html"
msgstr ""
"人間の直感に合う順序でリストをソートする。 ref: http://www.codinghorror.com/blog/2007/12"
"/sorting-for-humans-natural-sort-order.html"

#: 7200d6c7b78f41f9a7a692f24b0048ac of
