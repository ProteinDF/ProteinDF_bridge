#: b7dc5b27a94643ddbac762998d10ad21 of
#: proteindf_bridge.modeling.Modeling.add_methyl:1
msgid "Add the hydrogens of -CH3."
msgstr "-CH3の水素を付加"

#: e161951dcd7c4fb09854dfa21f70eaf6 of
#: proteindf_bridge.modeling.Modeling.add_methyl:3
msgid "Add a hydrogen to C1."
msgstr "C1に水素を付加"

#: 751e5b19077e47379d3313cfbc48c828 of
#: proteindf_bridge.modeling.Modeling.arbitary_rotate_matrix:1
msgid ""
"Return the rotation matrix R (3x3) such that applying R to `in_b` yields "
"a vector pointing in the direction of `in_a` (i.e. R.dot(in_b) is "
"parallel to in_a; see add_methyl/get_NH3 usage, which rotate a template's"
" own reference axis (in_b) onto a real bond direction (in_a))."
msgstr ""

#: 9fbb4bfbe3aa488cabbf2cfc6bf1de4a of
#: proteindf_bridge.modeling.Modeling.arbitary_rotate_matrix:7
#, python-format
msgid ""
"Note: prior to this fix, the (1, 2) matrix entry used `nx * nz` instead "
"of `ny * nz`, a bug inherited 1:1 by the Rust port (rust/crates"
"/proteindf-bridge/src/modeling.rs, arbitary_rotate_matrix). For a general"
" (non axis-aligned) input pair this produced a non-orthonormal matrix "
"(~1-2% error), not a proper rotation. Fixed here following the standard "
"Rodrigues rotation formula; verified numerically (rotated vector matches "
"the target direction to machine precision, matrix is orthonormal)."
msgstr ""

